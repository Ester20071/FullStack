<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <div class="container">
        <div class="topo">
            <a href="/cadastrar_post"><button>Cria Post</button></a>
        </div>

        <div class="lista-posts">
            <% if (listaPosts.length == 0) { %>
                <p>Nenhum post cadastrado ainda.</p>
            <% } else { %>
                <% for (var i = 0; i < listaPosts.length; i++) { %>
                    <div class="post">
                        <h2><%= listaPosts[i].titulo %></h2>
                        <p><%= listaPosts[i].resumo %></p>
                        <p><%= listaPosts[i].conteudo %></p>
                    </div>
                <% } %>
            <% } %>
        </div>
    </div>
</body>
</html>
